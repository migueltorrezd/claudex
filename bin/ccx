#!/usr/bin/env bash
# Managed by https://github.com/migueltorrezd/claudex
set -euo pipefail

config_file="${CCX_CONFIG_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/claudex/config}"
config_model=''
config_main_effort=''
config_bg_model=''
config_bg_effort=''
config_small_fast_model=''
config_context_window=''
config_proxy_url=''
config_proxy_transport=''
config_shim_url=''
config_subagent_guards=''
config_max_concurrent_subagents=''
config_max_subagents_per_session=''
config_max_subagent_spawn_depth=''
config_max_retries=''
config_api_timeout_ms=''

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

if [[ -f "$config_file" ]]; then
  # `|| [[ -n ... ]]` keeps the final line even without a trailing newline.
  while IFS='=' read -r config_key config_value || [[ -n "$config_key" ]]; do
    config_key="$(trim "${config_key%$'\r'}")"
    config_value="$(trim "${config_value%$'\r'}")"
    case "$config_key" in
      CCX_MODEL) config_model="$config_value" ;;
      CCX_MAIN_EFFORT) config_main_effort="$config_value" ;;
      CCX_BG_MODEL) config_bg_model="$config_value" ;;
      CCX_BG_EFFORT) config_bg_effort="$config_value" ;;
      CCX_SMALL_FAST_MODEL) config_small_fast_model="$config_value" ;;
      CCX_CONTEXT_WINDOW) config_context_window="$config_value" ;;
      CCX_PROXY_URL) config_proxy_url="$config_value" ;;
      CCX_PROXY_TRANSPORT) config_proxy_transport="$config_value" ;;
      CCX_SHIM_URL) config_shim_url="$config_value" ;;
      CCX_SUBAGENT_GUARDS) config_subagent_guards="$config_value" ;;
      CCX_MAX_CONCURRENT_SUBAGENTS) config_max_concurrent_subagents="$config_value" ;;
      CCX_MAX_SUBAGENTS_PER_SESSION) config_max_subagents_per_session="$config_value" ;;
      CCX_MAX_SUBAGENT_SPAWN_DEPTH) config_max_subagent_spawn_depth="$config_value" ;;
      CCX_MAX_RETRIES) config_max_retries="$config_value" ;;
      CCX_API_TIMEOUT_MS) config_api_timeout_ms="$config_value" ;;
    esac
  done < "$config_file"
fi

proxy_url="${CCX_PROXY_URL:-${config_proxy_url:-http://127.0.0.1:18765}}"
proxy_transport="${CCX_PROXY_TRANSPORT:-${config_proxy_transport:-http}}"
shim_url="${CCX_SHIM_URL:-${config_shim_url:-}}"
background_model="${CCX_SMALL_FAST_MODEL:-${CCX_BACKGROUND_MODEL:-${config_small_fast_model:-gpt-5.6-sol[1m]}}}"
subagent_guards="${CCX_SUBAGENT_GUARDS:-${config_subagent_guards:-1}}"
max_concurrent_subagents="${CCX_MAX_CONCURRENT_SUBAGENTS:-${config_max_concurrent_subagents:-3}}"
max_subagents_per_session="${CCX_MAX_SUBAGENTS_PER_SESSION:-${config_max_subagents_per_session:-12}}"
max_subagent_spawn_depth="${CCX_MAX_SUBAGENT_SPAWN_DEPTH:-${config_max_subagent_spawn_depth:-1}}"
max_retries="${CCX_MAX_RETRIES:-${config_max_retries:-3}}"
api_timeout_ms="${CCX_API_TIMEOUT_MS:-${config_api_timeout_ms:-300000}}"

print_models() {
  cat <<'EOF'
Usage: ccx [model|bg|solo] [claude arguments]

Models:
  sol       GPT-5.6 Sol (default)
  sol-fast  GPT-5.6 Sol, priority service tier
  terra     GPT-5.6 Terra
  terra-fast GPT-5.6 Terra, priority service tier
  luna      GPT-5.6 Luna
  luna-fast GPT-5.6 Luna, priority service tier
  5.5       GPT-5.5
  5.5-fast  GPT-5.5, priority service tier
  5.4       GPT-5.4
  5.4-fast  GPT-5.4, priority service tier
  mini      GPT-5.4 Mini
  mini-fast GPT-5.4 Mini, priority service tier
  5.3       GPT-5.3 Codex
  5.3-fast  GPT-5.3 Codex, priority service tier
  spark     GPT-5.3 Codex Spark
  spark-fast GPT-5.3 Codex Spark, priority service tier
  5.2       GPT-5.2
  5.2-fast  GPT-5.2, priority service tier

Modes:
  bg        Configured background lane (default: GPT-5.6 Sol, medium)
  solo      Disable the Agent tool for a session with no subagents

Examples:
  ccx
  ccx terra
  ccx bg
  ccx bg --bg "Run tests and fix failures"
  ccx solo -p "Review this repository without delegating"
  ccx --effort high -p "Review this repository"

Environment:
  CCX_CONFIG_FILE        Config path (default: ~/.config/claudex/config)
  CCX_MODEL              Default main-model alias or ID (default: sol)
  CCX_MAIN_EFFORT        Normal root-session effort (default: xhigh)
  CCX_BG_MODEL           Model for ccx bg (default: sol)
  CCX_BG_EFFORT          Root effort for ccx bg (default: medium)
  CCX_SMALL_FAST_MODEL   Utility/background-request model
  CCX_CONTEXT_WINDOW     Auto-compaction boundary (default: per model; 967000, spark 128000)
  CCX_PROXY_URL          Local proxy URL (default: http://127.0.0.1:18765)
  CCX_PROXY_TRANSPORT    Upstream Codex transport for a proxy started by ccx (default: http)
  CCX_SHIM_URL           Optional retry-shim URL fronting the proxy (see scripts/ccx-retry-shim.py)
  CCX_SUBAGENT_GUARDS     Apply bounded subagent/retry defaults (default: 1)
  CCX_MAX_CONCURRENT_SUBAGENTS  Concurrent subagent cap (default: 3)
  CCX_MAX_SUBAGENTS_PER_SESSION Total subagent spawn cap (default: 12)
  CCX_MAX_SUBAGENT_SPAWN_DEPTH  Nesting cap; 1 prevents recursive agents (default: 1)
  CCX_MAX_RETRIES         Claude Code request retry cap (default: 3)
  CCX_API_TIMEOUT_MS      Claude Code per-request timeout (default: 300000)
  CCX_REAL_CLAUDE        Claude Code executable
EOF
}

print_config() {
  cat <<EOF
Config file: $config_file
Main model: ${CCX_MODEL:-${config_model:-sol}}
Main effort: ${CCX_MAIN_EFFORT:-${config_main_effort:-xhigh}}
Background model: ${CCX_BG_MODEL:-${config_bg_model:-sol}}
Background effort: ${CCX_BG_EFFORT:-${CCX_BACKGROUND_EFFORT:-${config_bg_effort:-medium}}}
Utility model: $background_model
Context window: ${CCX_CONTEXT_WINDOW:-${config_context_window:-per-model default (967000; spark 128000)}}
Proxy URL: $proxy_url
Proxy Codex transport: $proxy_transport
Retry shim URL: ${shim_url:-not configured}
Subagent guards: $subagent_guards
Concurrent subagent cap: $max_concurrent_subagents
Subagents per session: $max_subagents_per_session
Subagent spawn depth: $max_subagent_spawn_depth
Request retry cap: $max_retries
Request timeout: ${api_timeout_ms}ms
EOF
}

validate_session_effort() {
  case "$1" in
    low|medium|high|xhigh|max|ultracode) ;;
    *)
      printf "ccx: unsupported effort '%s' (expected low, medium, high, xhigh, max, or ultracode)\n" "$1" >&2
      return 1
      ;;
  esac
}

validate_toggle() {
  local name="$1"
  local value="$2"
  case "$value" in
    0|1) ;;
    *)
      printf "ccx: %s must be 0 or 1 (got '%s')\n" "$name" "$value" >&2
      return 1
      ;;
  esac
}

validate_positive_integer() {
  local name="$1"
  local value="$2"
  if [[ ! "$value" =~ ^[1-9][0-9]*$ ]]; then
    printf "ccx: %s must be a positive integer (got '%s')\n" "$name" "$value" >&2
    return 1
  fi
}

validate_proxy_transport() {
  case "$1" in
    http|websocket|auto) ;;
    *)
      printf "ccx: CCX_PROXY_TRANSPORT must be http, websocket, or auto (got '%s')\n" "$1" >&2
      return 1
      ;;
  esac
}

resolve_model() {
  # Per-model auto-compaction boundary. Most lanes are 272k-class; spark is a
  # 128k model, and advertising 272k to Claude Code makes long sessions hit
  # upstream context-length errors instead of compacting.
  model_context_window='967000'
  case "$1" in
    sol|gpt-5.6-sol|'gpt-5.6-sol[1m]')
      selected_model='gpt-5.6-sol[1m]'
      model_name='GPT-5.6 Sol'
      ;;
    sol-fast|gpt-5.6-sol-fast|'gpt-5.6-sol-fast[1m]')
      selected_model='gpt-5.6-sol-fast[1m]'
      model_name='GPT-5.6 Sol Fast'
      ;;
    terra|gpt-5.6-terra|'gpt-5.6-terra[1m]')
      selected_model='gpt-5.6-terra[1m]'
      model_name='GPT-5.6 Terra'
      ;;
    terra-fast|gpt-5.6-terra-fast|'gpt-5.6-terra-fast[1m]')
      selected_model='gpt-5.6-terra-fast[1m]'
      model_name='GPT-5.6 Terra Fast'
      ;;
    luna|gpt-5.6-luna|'gpt-5.6-luna[1m]')
      selected_model='gpt-5.6-luna[1m]'
      model_name='GPT-5.6 Luna'
      ;;
    luna-fast|gpt-5.6-luna-fast|'gpt-5.6-luna-fast[1m]')
      selected_model='gpt-5.6-luna-fast[1m]'
      model_name='GPT-5.6 Luna Fast'
      ;;
    5.5|gpt-5.5|'gpt-5.5[1m]')
      selected_model='gpt-5.5[1m]'
      model_name='GPT-5.5'
      ;;
    5.5-fast|gpt-5.5-fast|'gpt-5.5-fast[1m]')
      selected_model='gpt-5.5-fast[1m]'
      model_name='GPT-5.5 Fast'
      ;;
    5.4|gpt-5.4|'gpt-5.4[1m]')
      selected_model='gpt-5.4[1m]'
      model_name='GPT-5.4'
      ;;
    5.4-fast|gpt-5.4-fast|'gpt-5.4-fast[1m]')
      selected_model='gpt-5.4-fast[1m]'
      model_name='GPT-5.4 Fast'
      ;;
    mini|5.4-mini|gpt-5.4-mini|'gpt-5.4-mini[1m]')
      selected_model='gpt-5.4-mini[1m]'
      model_name='GPT-5.4 Mini'
      ;;
    mini-fast|5.4-mini-fast|gpt-5.4-mini-fast|'gpt-5.4-mini-fast[1m]')
      selected_model='gpt-5.4-mini-fast[1m]'
      model_name='GPT-5.4 Mini Fast'
      ;;
    5.3|gpt-5.3-codex|'gpt-5.3-codex[1m]')
      selected_model='gpt-5.3-codex[1m]'
      model_name='GPT-5.3 Codex'
      ;;
    5.3-fast|gpt-5.3-codex-fast|'gpt-5.3-codex-fast[1m]')
      selected_model='gpt-5.3-codex-fast[1m]'
      model_name='GPT-5.3 Codex Fast'
      ;;
    spark|5.3-spark|gpt-5.3-codex-spark)
      selected_model='gpt-5.3-codex-spark'
      model_name='GPT-5.3 Codex Spark'
      model_context_window='128000'
      ;;
    spark-fast|5.3-spark-fast|gpt-5.3-codex-spark-fast)
      selected_model='gpt-5.3-codex-spark-fast'
      model_name='GPT-5.3 Codex Spark Fast'
      model_context_window='128000'
      ;;
    5.2|gpt-5.2|'gpt-5.2[1m]')
      selected_model='gpt-5.2[1m]'
      model_name='GPT-5.2'
      ;;
    5.2-fast|gpt-5.2-fast|'gpt-5.2-fast[1m]')
      selected_model='gpt-5.2-fast[1m]'
      model_name='GPT-5.2 Fast'
      ;;
    *)
      printf "ccx: unsupported model '%s'\n" "$1" >&2
      print_models >&2
      return 1
      ;;
  esac
}

requested_model="${CCX_MODEL:-${config_model:-sol}}"
selected_effort="${CCX_MAIN_EFFORT:-${config_main_effort:-xhigh}}"
solo_mode=0

case "${1:-}" in
  models|--models)
    print_models
    exit 0
    ;;
  config|--config)
    print_config
    exit 0
    ;;
  --model|-m)
    if [[ $# -lt 2 ]]; then
      printf 'ccx: %s requires a model\n' "$1" >&2
      exit 2
    fi
    requested_model="$2"
    shift 2
    ;;
  bg|background)
    requested_model="${CCX_BG_MODEL:-${config_bg_model:-sol}}"
    selected_effort="${CCX_BG_EFFORT:-${CCX_BACKGROUND_EFFORT:-${config_bg_effort:-medium}}}"
    shift
    ;;
  solo|no-agents)
    solo_mode=1
    shift
    ;;
  sol|sol-fast|terra|terra-fast|luna|luna-fast|5.5|5.5-fast|5.4|5.4-fast|mini|mini-fast|5.3|5.3-fast|spark|spark-fast|5.2|5.2-fast)
    requested_model="$1"
    shift
    ;;
  gpt-*|*'[1m]'*)
    # A bare full model ID used to fall through silently: the default model
    # ran and the token was passed to claude as a stray argument. Route it
    # through resolve_model so it either selects the model or errors loudly.
    requested_model="$1"
    shift
    ;;
esac

validate_session_effort "$selected_effort"
validate_toggle CCX_SUBAGENT_GUARDS "$subagent_guards"
validate_positive_integer CCX_MAX_CONCURRENT_SUBAGENTS "$max_concurrent_subagents"
validate_positive_integer CCX_MAX_SUBAGENTS_PER_SESSION "$max_subagents_per_session"
validate_positive_integer CCX_MAX_SUBAGENT_SPAWN_DEPTH "$max_subagent_spawn_depth"
validate_positive_integer CCX_MAX_RETRIES "$max_retries"
validate_positive_integer CCX_API_TIMEOUT_MS "$api_timeout_ms"
validate_proxy_transport "$proxy_transport"
resolve_model "$requested_model"
context_window="${CCX_CONTEXT_WINDOW:-${config_context_window:-$model_context_window}}"
validate_positive_integer CCX_CONTEXT_WINDOW "$context_window"

claude_bin="${CCX_REAL_CLAUDE:-}"
if [[ -z "$claude_bin" ]]; then
  claude_bin="$(command -v claude || true)"
fi
if [[ -z "$claude_bin" || ! -x "$claude_bin" ]]; then
  printf 'ccx: Claude Code is missing or not executable. Set CCX_REAL_CLAUDE or install Claude Code.\n' >&2
  exit 1
fi

health_check() {
  curl --silent --fail --max-time 1 "$proxy_url/healthz" >/dev/null 2>&1
}

start_proxy() {
  if command -v brew >/dev/null 2>&1; then
    brew services start claude-code-proxy >/dev/null 2>&1 || \
      brew services start raine/claude-code-proxy/claude-code-proxy >/dev/null 2>&1 || true
  elif command -v claude-code-proxy >/dev/null 2>&1; then
    local log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/claude-code-proxy"
    mkdir -p "$log_dir"
    nohup env CCP_CODEX_TRANSPORT="$proxy_transport" \
      claude-code-proxy serve --no-monitor >>"$log_dir/service.log" 2>&1 &
  fi

  local _
  for _ in $(seq 1 50); do
    if health_check; then
      return 0
    fi
    sleep 0.1
  done
  return 1
}

if [[ "${CCX_SKIP_HEALTH_CHECK:-0}" != '1' ]]; then
  if ! health_check; then
    if ! start_proxy; then
      printf 'ccx: proxy did not become healthy at %s/healthz\n' "$proxy_url" >&2
      printf 'ccx: run ./scripts/doctor.sh from the Claudex repository for diagnostics.\n' >&2
      exit 1
    fi
  fi

  # Auth gate: healthz only proves the HTTP server is alive, not that the
  # Codex OAuth token works. A dead token turns every request into a 401.
  if command -v claude-code-proxy >/dev/null 2>&1; then
    if ! auth_status="$(claude-code-proxy codex auth status 2>&1)"; then
      printf 'ccx: Codex authentication is broken:\n%s\n' "$auth_status" >&2
      printf 'ccx: run: claude-code-proxy codex auth login\n' >&2
      exit 1
    fi
    case "$auth_status" in
      *[Ee]xpired*)
        printf 'ccx: Codex token is expired; run: claude-code-proxy codex auth login\n' >&2
        exit 1
        ;;
    esac
  fi
fi

# Prefer a retry shim when one is configured (CCX_SHIM_URL): it transparently
# retries transient 401/5xx responses from the proxy (token-refresh races
# under parallel load) that would otherwise kill subagents and workflows.
# See scripts/ccx-retry-shim.py.
base_url="$proxy_url"
if [[ -n "$shim_url" ]]; then
  if [[ "${CCX_SKIP_HEALTH_CHECK:-0}" == '1' ]] || \
     curl --silent --fail --max-time 2 "$shim_url/healthz" >/dev/null 2>&1; then
    base_url="$shim_url"
  else
    printf 'ccx: warning: retry shim %s is unavailable; using the proxy directly\n' "$shim_url" >&2
  fi
fi

export ANTHROPIC_BASE_URL="$base_url"
export ANTHROPIC_AUTH_TOKEN='unused'
export ANTHROPIC_MODEL="$selected_model"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$background_model"
export ANTHROPIC_SMALL_FAST_MODEL="$background_model"
export ANTHROPIC_CUSTOM_MODEL_OPTION="$selected_model"
export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME="$model_name (OpenAI subscription)"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="$context_window"
export CLAUDE_CODE_ALWAYS_ENABLE_EFFORT="${CLAUDE_CODE_ALWAYS_ENABLE_EFFORT:-1}"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC='1'
export CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK='1'

if [[ "$subagent_guards" == '1' ]]; then
  export CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS="${CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS:-$max_concurrent_subagents}"
  export CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION="${CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION:-$max_subagents_per_session}"
  export CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH="${CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH:-$max_subagent_spawn_depth}"
  export CLAUDE_CODE_MAX_RETRIES="${CLAUDE_CODE_MAX_RETRIES:-$max_retries}"
  export API_TIMEOUT_MS="${API_TIMEOUT_MS:-$api_timeout_ms}"
fi

has_effort_argument=0
for argument in "$@"; do
  if [[ "$argument" == '--effort' || "$argument" == --effort=* ]]; then
    has_effort_argument=1
    break
  fi
done

claude_command=("$claude_bin" --model "$selected_model")
if [[ "$has_effort_argument" -eq 0 ]]; then
  claude_command+=(--effort "$selected_effort")
fi
if [[ "$solo_mode" -eq 1 ]]; then
  claude_command+=(--disallowedTools Agent)
fi

exec "${claude_command[@]}" "$@"
