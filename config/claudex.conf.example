# Managed by https://github.com/migueltorrezd/claudex
# Plain key=value configuration. Do not put credentials in this file.
CCX_MODEL=sol
CCX_MAIN_EFFORT=xhigh
CCX_BG_MODEL=sol
CCX_BG_EFFORT=medium
CCX_SMALL_FAST_MODEL=gpt-5.6-sol[1m]
CCX_SUBAGENT_EFFORT=high
CCX_SUBAGENT_GUARDS=1
CCX_MAX_CONCURRENT_SUBAGENTS=3
CCX_MAX_SUBAGENTS_PER_SESSION=12
CCX_MAX_SUBAGENT_SPAWN_DEPTH=1
CCX_MAX_RETRIES=3
CCX_API_TIMEOUT_MS=300000
# Leave CCX_CONTEXT_WINDOW unset for the per-model default
# (272000 for most lanes, 128000 for spark).
#CCX_CONTEXT_WINDOW=272000
CCX_PROXY_URL=http://127.0.0.1:18765
# HTTP was reliable at 100 scheduled workflow agents; the upstream default
# WebSocket transport failed transient upgrades during the same stress burst.
CCX_PROXY_TRANSPORT=http
# Optional retry shim fronting the proxy; see scripts/ccx-retry-shim.py
# and the "Reliability" section of the README.
#CCX_SHIM_URL=http://127.0.0.1:18767
